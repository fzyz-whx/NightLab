# NightLab reads process environment; it does not automatically load .env files.
# These are non-secret local defaults, not credentials.
# PowerShell example: $env:NIGHTLAB_DATA_DIR='private/app'
NIGHTLAB_DATA_DIR=private/app
# Optional Vite development proxy target; production uses the same-origin API.
NIGHTLAB_API_URL=http://127.0.0.1:8766
