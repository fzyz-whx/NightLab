# Byte-hashed research inputs must keep their audited line endings on checkout.
* text=auto eol=lf
*.py text eol=lf
*.json text eol=crlf
frontend/*.json text eol=lf
*.svg text eol=crlf
*.lock text eol=crlf
*.png -text
*.jpg -text

# Gradle on the audited Windows toolchain emits these provenance files with CRLF.
android/gradle/verification-metadata.xml text eol=crlf
android/*.lockfile text eol=crlf
android/app/*.lockfile text eol=crlf
